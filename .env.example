# Safe local/deployment configuration example. Copy to .env outside source
# control and replace placeholders; never commit real credentials or secrets.
# Explicit operating-system environment variables override this file.

APP_ENV=development
FLASK_SECRET_KEY=<generate-at-least-32-random-characters>
DATABASE_PATH=<absolute-path-to-runtime-data>/transport.db
UPLOAD_DIR=<absolute-path-to-runtime-uploads>
SESSION_COOKIE_SECURE=0
TRUSTED_PROXY_COUNT=0
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
ENABLE_AI_NLP=0
# Keep V1 active until the local V2 training/evaluation promotion gate passes.
TRAINED_CHAT_MODEL_VERSION=v1
VOICE_STT_ENGINE=whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VOICE_PARTIAL_INTERVAL_MS=2000
VOICE_CLIENT_MAX_RECORDING_SECONDS=45

# Set the public application URL in production. It is used to build reset links.
APP_BASE_URL=http://127.0.0.1:5000

# Password-reset email delivery. Choose console, smtp, or sendgrid.
# console is development-only and never sends a real email.
EMAIL_PROVIDER=smtp

# Gmail standard STARTTLS. SMTP_PASSWORD MUST be a Google/Gmail App Password,
# not the normal Gmail account password. Enable two-step verification first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=<gmail-app-password>
EMAIL_FROM=your-address@gmail.com
EMAIL_FROM_NAME=NEYAN AI

# Alternative for a network that blocks port 587: implicit TLS / SMTPS.
# SMTP_PORT=465
# SMTP_SECURITY=ssl

# SendGrid alternative (use EMAIL_PROVIDER=sendgrid and provide a verified sender).
SENDGRID_API_KEY=<sendgrid-api-key>
